/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* finalPrices(int* prices, int pricesSize, int* returnSize) {
    int i = 0;
    while(i < pricesSize) {
        int j = i + 1;
        while(j < pricesSize) {
            if(prices[j] <= prices[i]) {
                prices[i] = prices[i] - prices[j];
                break;
            }
            j++;
        }
        i++;
    }
    *returnSize = pricesSize;
    return prices;
}
