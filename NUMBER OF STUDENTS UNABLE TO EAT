int countStudents(int* students, int studentsSize, int* sandwiches, int sandwichesSize) {
    int remain_student_idx = 0;
    int sandwich_idx = 0;

    for(int i = 0; i < studentsSize; i++) {
        if(students[i] == sandwiches[sandwich_idx]) {
            sandwich_idx++;
            continue;
        }

        students[remain_student_idx++] = students[i];
    }

    if(!remain_student_idx) {
        return 0;
    }

    while(!!remain_student_idx) {
        int new_remain_student_idx = 0;
        for(int i = 0; i < remain_student_idx; i++) {
            if(students[i] == sandwiches[sandwich_idx]) {
                sandwich_idx++;
                continue;
            }

            students[new_remain_student_idx++] = students[i];
        }

        if(new_remain_student_idx == remain_student_idx) {
            return remain_student_idx;
        }

        remain_student_idx = new_remain_student_idx;
    }

    return remain_student_idx;
}
