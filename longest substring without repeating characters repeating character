int max(int a, int b) {
    return a>b?a:b;
}

int lengthOfLongestSubstring(char* s) {
    char* seen[256] = {0};
    unsigned char c;
    char* start = s;
    int res = 0;

    for (; *s; ++s) {
        c = *s;
        if (seen[c] && seen[c] >= start) {
            start = seen[c] + 1;  // Move start just past previous duplicate
        }
        seen[c] = s;
        res = max(res, s - start + 1);
    }

    return res;
}
